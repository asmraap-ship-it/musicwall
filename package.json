    "electron-rebuild": "^3.2.9"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ffmpeg-static": "^5.3.0",
    "gsap": "^3.15.0",
    "music-metadata": "^11.14.0"
